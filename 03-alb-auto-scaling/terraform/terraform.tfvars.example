# Copy to terraform.tfvars locally and replace placeholders.
# Do not commit terraform.tfvars or real account-specific values.
aws_region = "ap-south-1"
vpc_id = "vpc-REPLACE_ME"
public_subnet_ids = [
  "subnet-PUBLIC_A_REPLACE_ME",
  "subnet-PUBLIC_B_REPLACE_ME"
]
private_subnet_ids = [
  "subnet-PRIVATE_A_REPLACE_ME",
  "subnet-PRIVATE_B_REPLACE_ME"
]
instance_type = "t3.micro"
min_size = 2
max_size = 4
desired_capacity = 2
