# Example values only. Copy to terraform.tfvars locally and review before use.
# Never commit terraform.tfvars or AWS credentials.
aws_region         = "ap-south-1"
project_name       = "aws-tf-demo"
vpc_cidr           = "10.30.0.0/16"
public_subnet_cidr = "10.30.1.0/24"
availability_zone  = "ap-south-1a"
instance_type      = "t3.micro"
http_ingress_cidr  = "0.0.0.0/0"
root_volume_size   = 8
